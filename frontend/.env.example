# Local development (Next.js proxies /api to the backend via next.config.ts)
# BACKEND_URL=http://localhost:3001

# Production — set on Vercel/Render frontend host
# BACKEND_URL=https://concordiaorbis-api.onrender.com
# NEXT_PUBLIC_SITE_URL=https://your-frontend-domain.com
# NEXT_PUBLIC_API_URL=https://concordiaorbis-api.onrender.com

# NEXT_PUBLIC_SMS_PHONE_VERIFICATION_ENABLED=true
# NEXT_PUBLIC_GOOGLE_DEV_MODE=false
