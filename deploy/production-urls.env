# Production URLs — ConcordiaOrbis
# Site:  https://concordiaorbis-platform-one.vercel.app  (Vercel)
# API:   https://concordiaorbis-api.onrender.com         (Render)

# ─── Render → concordiaorbis-api → Environment ───────────────────────────────
# FRONTEND_URL and GOOGLE_REDIRECT_URI are set by render.yaml on Blueprint sync.
# Copy these manually from the old ani-platform-api service:
#
#   JWT_SECRET=...
#   JWT_REFRESH_SECRET=...
#   GOOGLE_CLIENT_ID=...
#   GOOGLE_CLIENT_SECRET=...
#   CLOUDINARY_CLOUD_NAME=...
#   CLOUDINARY_API_KEY=...
#   CLOUDINARY_API_SECRET=...
#
# After sync, verify:
#   FRONTEND_URL=https://concordiaorbis-platform-one.vercel.app
#   GOOGLE_REDIRECT_URI=https://concordiaorbis-api.onrender.com/api/auth/google/callback

# ─── Vercel → Project → Settings → Environment Variables (Production) ─────
# BACKEND_URL=https://concordiaorbis-api.onrender.com
# NEXT_PUBLIC_SITE_URL=https://concordiaorbis-platform-one.vercel.app
# NEXT_PUBLIC_API_URL=https://concordiaorbis-api.onrender.com
# NEXT_PUBLIC_GOOGLE_DEV_MODE=false

# ─── Google Cloud Console → OAuth client ───────────────────────────────────
# Authorized JavaScript origins:
#   https://concordiaorbis-platform-one.vercel.app
# Authorized redirect URIs:
#   https://concordiaorbis-api.onrender.com/api/auth/google/callback
