# PostgreSQL (required — schema.prisma uses provider = "postgresql")
#
# Render production DB (no shell needed):
#   1. Render Dashboard → your PostgreSQL service → Connections
#   2. Copy "External Database URL"
#   3. Paste below (or into backend/.env locally to run db:push from your machine)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
#
# Local PostgreSQL via Docker (docker compose up -d):
# DATABASE_URL="postgresql://ani_user:ani_password@localhost:5432/ani_platform?schema=public"
#
# Apply schema without Render shell:
#   - Deploy: `npm run build` on Render runs `prisma db push` automatically
#   - Local:  set DATABASE_URL above, then `npm run db:push`
DATABASE_URL="postgresql://ani_user:ani_password@localhost:5432/ani_platform?schema=public"

JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-another-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
# Render: bind to all interfaces (render.yaml sets this automatically)
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
# In dev, loca.lt tunnel + LAN IPs are also allowed automatically.
# For production, set your live frontend URL(s), comma-separated:
# FRONTEND_URL="https://your-app.vercel.app"

# Cloudinary — required on Render (ephemeral disk). Free tier: https://cloudinary.com
# Without these, uploads are stored on local disk and lost on redeploy/restart.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (local): http://localhost:3001/api/auth/google/callback
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"
# API_URL="http://localhost:3001"
# GOOGLE_DEV_MODE=true

# Email verification (optional — without SMTP, codes are logged to the server console)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# EMAIL_FROM="ANI Platform <noreply@yourdomain.com>"
